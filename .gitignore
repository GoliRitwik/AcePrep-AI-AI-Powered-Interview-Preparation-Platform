# ── Root-level catch-all ─────────────────────────────────────────────────────
# Both Frontend/ and Backend/ have their own .gitignore files.
# This root file catches anything that might slip through at the repo level.

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Environment variables — NEVER commit real secrets
.env
.env.*
!.env.example

# Dependency directories
node_modules/

# Logs
*.log
logs/
