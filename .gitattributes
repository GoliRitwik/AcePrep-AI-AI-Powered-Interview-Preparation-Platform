# Normalise line endings to LF in the repo, checkout as CRLF on Windows
* text=auto eol=lf

# Force these to always be LF (scripts, JSON, configs)
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.scss text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
